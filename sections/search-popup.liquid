<search-popup class="header__search-popup">
    <div class="section-container search-container">
    </div>
</search-popup>
<div class="header__search-bg-overlay"></div>
{% javascript %}
class SearchPopup extends HTMLElement {
    #abortController = null;
    #form = null;
    connectedCallback() {
        this.#init();
    }
    #init(){
        this.updateSearchContent();
        this.#form = document.querySelector('.header__search-form')
        document.querySelectorAll('.header__search-form').forEach(ele => {
            const field = ele.querySelector('.header__search-field');
            ['click', 'focus'].forEach(eventType => {
            field.addEventListener(eventType, e => {
                e.preventDefault();
                // Search and the megamenu both re-skin the mobile toggle icon,
                // so they must never be open at the same time.
                document.body.classList.remove('megamenu-active');
                document.body.classList.add('search-active');
                this.#syncHasText();
            })
            });
            field.addEventListener('keyup', e => {
                this.updateSearchContent(field.value);
            })
            // 'input' also fires for paste, autofill and the native clear
            // control, none of which fire keyup — the X would go stale.
            field.addEventListener('input', () => this.#syncHasText());
        })
        // The X clears the query. Dismissing the panel is the overlay's job on
        // desktop, and the mobile back arrow's (wired in header-alt.liquid).
        document.querySelectorAll('.header__search-form-close').forEach(ele => {
            ele.addEventListener('click', e => {
                e.preventDefault();
                const field = this.#form.querySelector('.header__search-field');
                field.value = '';
                this.#syncHasText();
                this.updateSearchContent();
                field.focus();
            })
        })
        document.querySelectorAll('.header__search-bg-overlay').forEach(ele => {
            ele.addEventListener('click', e => {
                e.preventDefault();
                document.body.classList.remove('search-active');
            })
        })
        this.addEventListener('click', function (event) {
            const target = event.target.closest('.header__search-keyword');
            if (!target) return;
            console.log('Target clicked:', target);
            event.preventDefault();
            // Your event handler logic goes here
            this.#form.querySelector('.header__search-field').value = target.dataset.keyword;
            this.#syncHasText();
            this.updateSearchContent(target.dataset.keyword);
        });
        // /search renders the field pre-filled from search.terms, so the X has
        // to reflect that on load, not just on the first keystroke.
        this.#syncHasText();
    }
    /**
     * Mirrors "the field has a query in it" onto the body, so CSS can decide
     * whether the clear icon is worth showing.
     */
    #syncHasText(){
        const field = this.#form && this.#form.querySelector('.header__search-field');
        document.body.classList.toggle('search-has-text', !!(field && field.value.trim()));
    }
    async updateSearchContent(terms = null){
        this.classList.add('ajax-loading');
        const html =await this.fetchSearch(terms);
        this.querySelector('.search-container').innerHTML = html.innerHTML;
        this.classList.remove('ajax-loading');
    }
    fetchSearch(terms = null){

        if (this.#abortController) {
            // const parser = document.createElement('div');
            // parser.innerHTML = response;
            // const ajaxContainer = parser.querySelector('[data-ajax-container="products"]');
            this.#abortController.abort();
        }

        this.#abortController = new AbortController();
        const signal = this.#abortController.signal;
        const url = theme.routes.search_url + '?type=product&view=ajax-rehall' + (terms == null ? '' : '&q='+ terms );
        

        // $('.header__search-form-results').addClass('ajax-loading');
        return fetch(url, {signal}).
        then((response) => {
            if (!response.ok) {
            throw new Error(`HTTP error! Status: ${response.status}`);
            }
            return response.text();
        }).
        then((response) => {
            const parser = document.createElement('div');
            parser.innerHTML = response;
            const ajaxContainer = parser.querySelector('[data-ajax-container="search"]');
            return ajaxContainer;
        });
    }
}

customElements.define('search-popup', SearchPopup);
{% endjavascript %}
{% style %}
.header__search-popup{
    position: fixed;
    top: 0;
    left: 0;
    padding-top: calc(var(--theme-header-height) + 42px);
    width: 100%;
    z-index: 5555;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-50%);
    transition: 0.2s ease-out;
    transition-property: transform,opacity,visibility, padding,height;
    background: #FFF;
    height: calc(589px + var(--theme-header-height) + 42px);
    max-height: 100vh;
    overflow: visible auto;
    overscroll-behavior: contain;
    @media only screen and (max-width: 767px) {
        height: 100vh;
    }
    .floating-header &{
        height: calc(589px + var(--theme-sticky-header-height));
        padding-top: var(--theme-sticky-header-height);
        @media only screen and (max-width: 767px) {
            height: 100vh;
        }
    }
    .header__search_title{
        font-weight: 600;
        margin-bottom: 22px;
        font-size: 18px;
        line-height: 100%;
        text-transform: none;
        @media only screen and (max-width: 767px) {
            font-size: 14px;
        }
    }
    .header__search_title-wrap{
        margin-bottom: 22px;
        display: flex;
        grid-gap: 30px;
        justify-content: space-between;
        .header__search_title{
            margin-bottom: 0;
        }
        .header__serach_view-all{
            font-family: var(--header-font-family);
            font-size: 14px;
            line-height: 100%;
            .highlight{
                font-weight: 600;
            }
        }
    }
    &.ajax-loading {
        opacity: 1 !important;
        /* transition: opacity 250ms; */
        /* position: relative; */
        min-height: 200px;
        &::after {
            content: "";
            position: absolute;
            top: 150px;
            left: calc(50% - 40px / 2);
            width: 40px;
            height: 40px;
            border-radius: 100%;
            border: 1px solid transparent;
            border-left-color: currentColor;
            opacity: 0.75;
            animation: filterLoadingSpinAnimation 1s linear infinite;
            @media only screen and (max-width: 767px) {
                top: 240px;
            }
        }
    }
    .header__search_res-wrap{
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        grid-gap: 30px 10px;
        @media only screen and (max-width: 767px) {
            margin: 0 -22px;
            grid-gap: 10px;
            grid-template-columns: repeat(2, 1fr);
        }
    }
    .product-block.custom{
        .product__floating-bar,.product-block-options{
            display: none;
        }
        .inline-image__pad{
            height: 328px;
            @media only screen and (max-width: 767px) {
                height: 218px;
            }
        }
        .product-info.info_alt.grid{
            grid-template-columns: 1fr;
            font-size: 14px;
            color: #202020;
            font-family: var(--header-font-family);
            @media only screen and (max-width: 767px) {
                padding: 18px 18px 28px;
                margin: 0;
                grid-gap: 10px;
                color: #4A4A4A;
            }
        }
        .product-block__price-row{
            .product-price{
                color: #1E1E1E;
            }
            .jdgm-prev-badge, .jdgm-star {
                color: #4A4A4A;
            }
            @media screen and (max-width: 767px){
                display: contents;
                .jdgm-prev-badge{
                    margin-top: 0;
                    margin: 0;
                    padding: 0;
                    border: none;
                }
            }
            .jdgm-prev-badge {
                display: flex !important;
                align-items: center;
            }
            .jdgm-prev-badge__stars{
                /* color: #908F90; */
                display: inline-flex;
                font-size: 12px;
            }
        }
    }
    .search__empty-notice{
        font-size: 16px;
        text-transform: none;
        font-weight: 500;
        .header__search-kewords-wrap &{
            font-weight: 400;
            font-size: 14px;
        }
    }
}
body.search-active .header__search-popup {
    opacity: 1;
    visibility: visible;
    transform: translateY(0%);
}
.header__search-head-wrap{
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
}
.header__search-head{
    padding: 20px 0;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
}
.header__search-popup .header__search-form{
    width: 299px;
    grid-column: 2;
}
.header__search-popup-close{
  display: flex;
  transition: 0.3s ease-out;
  transition-property: opacity;
  color: inherit;
  z-index: 2;
  opacity: 0.6;
  /* width: 24px;
    height: 24px; */
    justify-self: end;
}
.header__search-popup-close:hover{
    opacity: 1;
}
.header__search-popup-close svg{
  width: 24px;
    height: 24px;
}
.search-container{
    padding-top: 48px;
    padding-bottom: 48px;
    @media only screen and (max-width: 767px) {
        padding-top: 30px;
        padding-bottom: calc(env(safe-area-inset-bottom,30px) + 130px);
    }
}
.header__search-wrap{
    display: grid;
    grid-template-columns: 1fr minmax(500px, 1174px);
    grid-gap: 40px;
    font-family: var(--header-font-family);
    @media only screen and (max-width: 767px) {
        grid-template-columns: 100%;
    }
}
.header__search-bg-overlay{
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    visibility: hidden;
    opacity: 0;
    transition: .4s ease-out;
    transition-property: visibility, opacity;
    /* background: rgba(255, 255, 255, 0.10);
    backdrop-filter: blur(7.5px); */
    z-index: 500;
    background: rgba(0, 0, 0, 0.30);
    backdrop-filter: blur(5px);
}
body.search-active .header__search-bg-overlay{
    visibility: visible;
    opacity: 1;
}
.header__search_categories-wrap{
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-gap: 20px 10px;
    @media only screen and (max-width: 767px) {
        margin: 0 -22px;
        grid-template-columns: repeat(2, 1fr);
    }
}
.header__search_category {
    display: flex;
    flex-direction: column;
}
.header__search_category-img{
    height: 328px;
    object-fit: cover;
    object-position: top;
    width: 100%;
    @media only screen and (max-width: 767px) {
        height: auto;
        aspect-ratio: 1;
        object-fit: contain;
        background-color: #ece9ec;
    }
}
.header__search-kewords{
    display: flex;
    flex-direction: column;
    grid-gap: 22px;
    text-transform: capitalize;
    @media only screen and (max-width: 767px) {
        font-size: 12px;
        line-height: 150%; 
    }
}
.header__search_category-title{
    margin-top: 14px;
    font-weight: 500;
    line-height: 120%;
    font-family: var(--header-font-family);
    color: #202020;
    text-transform: none;
    font-size: 14px;
    @media only screen and (max-width: 767px) {
        font-size: 12px;
        line-height: 100%;
        padding: 0 10px;
        margin: 14px 0 0;
    }
}
{% endstyle %}
{% schema %}
{
  "name": "Search Popup",
  "class": "header__search-popup-wrap",
  "tag": "div",
  "enabled_on": {
    "groups": ["aside"]
  },
  "settings": [
    {
        "type": "inline_richtext",
        "id": "title",
        "label": "Title",
        "default": "Unique gloves from Oberammergau"
    },
  ]
}
{% endschema %}
